# Swarm-in-a-Box Environment Configuration
# ==========================================
# Copy this file to the project root as `.env` and fill in your values.
# NEVER commit `.env` to git — it contains secrets.
#
# Quick start:
#   cp docker/.env.example .env
#   nano .env
#   ./docker/setup.sh
#   docker compose up -d

# ---------------------------------------------------------------------------
# Host User Mapping (critical for file permissions)
# ---------------------------------------------------------------------------
# Set these to your host UID/GID so files created inside the container are
# readable/writable on the host. On macOS/Linux:
#   HERMES_UID=$(id -u)
#   HERMES_GID=$(id -g)
# On NAS/Synology/unRAID, use PUID/PGID aliases instead.
HERMES_UID=1000
HERMES_GID=1000

# ---------------------------------------------------------------------------
# Hermes Agent Paths
# ---------------------------------------------------------------------------
# Path to the hermes-agent source (used for building the Docker image).
# If you have the hermes-agent repo cloned elsewhere, update this.
HERMES_AGENT_PATH=./hermes-agent

# Path to the Hermes home directory on the host. This stores config, auth,
# sessions, logs, skills, and profiles.
HERMES_HOME=~/.hermes

# Path to the profiles directory. By default this is ~/.hermes/profiles.
HERMES_PROFILES=~/.hermes/profiles

# Optional: Git SHA to bake into the image for version tracking.
HERMES_GIT_SHA=

# ---------------------------------------------------------------------------
# API Keys (required for model providers)
# ---------------------------------------------------------------------------
# Primary provider: Fireworks AI (Kimi, Firepass, etc.)
FIREWORKS_API_KEY=fw_*YOUR_KEY_HERE*

# Fallback / auxiliary providers
OPENROUTER_API_KEY=sk-or-*YOUR_KEY_HERE*
ANTHROPIC_API_KEY=sk-ant-*YOUR_KEY_HERE*
OPENAI_API_KEY=sk-*YOUR_KEY_HERE*

# ---------------------------------------------------------------------------
# Messaging Platform Tokens
# ---------------------------------------------------------------------------
# Discord bot token (for gateway Discord platform)
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN

# Telegram bot token (for gateway Telegram platform)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Comma-separated list of Telegram user IDs allowed to interact with the bot.
TELEGRAM_ALLOWED_USERS=

# ---------------------------------------------------------------------------
# Hermes API Server
# ---------------------------------------------------------------------------
# Set API_SERVER_HOST to 0.0.0.0 to listen on all interfaces (inside the
# container network). Keep empty or set to 127.0.0.1 for localhost-only.
API_SERVER_HOST=0.0.0.0

# Mandatory if exposing the API server beyond localhost. Generate a strong key:
#   openssl rand -hex 32
API_SERVER_KEY=

# ---------------------------------------------------------------------------
# Paperclip API
# ---------------------------------------------------------------------------
# Paperclip company ID (UUID format)
PAPERCLIP_COMPANY_ID=c5ea22fb-99d2-46a1-87c6-e7fc1ab0d712

# Paperclip API key for authentication
PAPERCLIP_API_KEY=your-paperclip-api-key

# ---------------------------------------------------------------------------
# Optional: Pre-seed auth.json on first boot (base64-encoded JSON or raw)
# ---------------------------------------------------------------------------
# HERMES_AUTH_JSON_BOOTSTRAP={"access_token":"...","refresh_token":"..."}

# ---------------------------------------------------------------------------
# Port Mappings
# ---------------------------------------------------------------------------
# Adjust these if the default ports are already in use on the host.
CHROMA_HOST_PORT=8000
PAPERCLIP_HOST_PORT=3100
GATEWAY_API_PORT=8080
DASHBOARD_PORT=9119

# ---------------------------------------------------------------------------
# Memory Limits (per container)
# ---------------------------------------------------------------------------
# Adjust based on your host capacity. For a small VPS (2-4 GB total),
# reduce these. For a dedicated machine (16+ GB), you can increase.
CHROMA_MEMORY_LIMIT=2G
PAPERCLIP_MEMORY_LIMIT=512M
GATEWAY_MEMORY_LIMIT=2G
AGENT_RUNNER_MEMORY_LIMIT=4G

# ---------------------------------------------------------------------------
# Optional: Watchtower Notifications
# ---------------------------------------------------------------------------
# Shoutrrr URL for container update notifications (Discord webhook, Slack, etc.)
# Examples:
#   discord://token@webhookid
#   slack://token@channel
#   telegram://token@chatid
WATCHTOWER_NOTIFICATION_URL=
