# docker-compose.override.yml — Local Overrides
# ==========================================
# Copy this file to `docker-compose.override.yml` and edit for your local
# environment. Docker Compose automatically merges override files.
#
# Example overrides:
#   - Use a pre-built Hermes image instead of building from source
#   - Mount extra host directories into the container
#   - Add a reverse proxy (Traefik, nginx) labels
#   - Override memory limits for a low-resource VPS

services:
  gateway:
    # Use a pre-built image instead of building locally
    # image: nousresearch/hermes-agent:latest
    # Uncomment to add extra environment variables:
    # environment:
    #   - HERMES_VERBOSE=true
    # Uncomment to bind-mount extra directories:
    # volumes:
    #   - /home/you/projects:/projects:ro

  chroma:
    # Reduce memory for a small VPS
    # deploy:
    #   resources:
    #     limits:
    #       memory: 512M

  # Example: add a reverse-proxy label for Traefik
  # dashboard:
  #   labels:
  #     - "traefik.enable=true"
  #     - "traefik.http.routers.swarm-dashboard.rule=Host(`swarm.local`)"
  #     - "traefik.http.services.swarm-dashboard.loadbalancer.server.port=9119"
